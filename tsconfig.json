{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "strict": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["bun", "vite/client"]
  },
  "include": [
    "src/**/*",
    "playground/**/*",
    "test/**/*",
    "playwright.config.ts"
  ]
}
