{
  "name": "videolight",
  "version": "0.1.0-alpha.0",
  "description": "Read the colours along the edges of a <video> and use them: halo, ambient background, theme variables, letterbox fill.",
  "keywords": [
    "video",
    "ambient",
    "ambilight",
    "halo",
    "glow",
    "colors",
    "react",
    "canvas"
  ],
  "license": "MIT",
  "author": "Geoffrey Signorato",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "assets": "bash playground/make-assets.sh",
    "build": "vite build",
    "check": "ultracite check",
    "dev": "vite playground",
    "dev:lan": "vite playground --host",
    "fix": "ultracite fix",
    "lint:pkg": "publint && attw --pack . --profile esm-only",
    "prepack": "bun run build",
    "prepare": "lefthook install",
    "servers": "bun playground/servers.ts",
    "servers:lan": "HOST=0.0.0.0 bun playground/servers.ts",
    "test": "bun test src playground",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "^1.65.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "hls.js": "^1.7.4",
    "lefthook": "^2.2.2",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "7",
    "ultracite": "8.2.1",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
